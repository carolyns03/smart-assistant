# ─── Data Source Mode ───
# Set to "live" to fetch from real APIs, or leave unset for JSON demo files
# DATA_SOURCE=live

# ─── Google Gemini API Configuration ───
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model name (defaults to gemini-2.0-flash if not set)
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the API endpoint
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions


# ─── Slack API Configuration ───
# 1. Create app at https://api.slack.com/apps
# 2. Add Bot Token Scopes: channels:read, channels:history,
#    groups:read, groups:history, users:read.email
# 3. Install app → copy Bot User OAuth Token
# 4. Invite bot to channels: /invite @YourBotName
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Optional: limit to specific channels (comma-separated)
# SLACK_CHANNELS=#general,#engineering,#security-incidents


# ─── Jira API Configuration (Atlassian Cloud) ───
# 1. Go to https://developer.atlassian.com/console/ → Create app
# 2. Add Jira Platform REST API → scope: read:jira-work
# 3. Generate token
JIRA_API_TOKEN=your-jira-api-token
JIRA_EMAIL=your-email@company.com
JIRA_BASE_URL=https://yourcompany.atlassian.net
# Optional: limit to one project
# JIRA_PROJECT_KEY=ENG


# ─── Confluence API Configuration (Atlassian Cloud) ───
# 1. Reuse same Atlassian app or create new one
# 2. Add Confluence Cloud REST API → scopes: read:confluence-content, read:confluence-space
# 3. Generate token
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
# Optional: limit to one space
# CONFLUENCE_SPACE_KEY=ENG


# ─── Google Drive API Configuration ───
# 1. Go to https://console.cloud.google.com/ → enable Google Drive API
# 2. Create OAuth 2.0 credentials or Service Account
# 3. Get an access token with drive.readonly scope
# Quick test: https://developers.google.com/oauthplayground/
DRIVE_ACCESS_TOKEN=your-google-drive-access-token
# Optional: limit to a specific folder ID
# DRIVE_FOLDER_ID=1a2b3c4d5e6f
