# Tencent Cloud ADP Chat API configuration
# Set these to enable real ADP integration. If not set, the system runs in fallback (demo) mode.

# Your ADP application key (required for ADP mode)
ADP_APP_KEY=

# ADP API endpoint (optional, defaults to https://api.lkeap.tencentcloud.com/v1/app/chat)
ADP_API_URL=

# Base visitor ID for session separation (optional, defaults to "internal-brain-")
# Per-user suffix is appended automatically for session isolation
ADP_VISITOR_ID=
